            "author": "OpenDeck Team",
            "version": "0.1.0",
            "tags": [
                "keyboard",
                "macro",
                "hotkey",
                "windows"
            ],
            "repo": "https://github.com/BarrassDev/openDeck",
            "cloneUrl": "https://github.com/BarrassDev/openDeck.git",
            "subdirectory": "modules/macro",
            "homepage": "https://github.com/BarrassDev/openDeck",
            "license": "MIT",
            "bundled": true
        },
        {
            "id": "media-controls",
            "name": "Media Controls",
            "description": "Control media playback on Windows \u2014 play/pause, next/previous track, volume up/down, and mute.",
            "author": "OpenDeck Team",
            "version": "0.1.0",
            "tags": [
                "media",
                "audio",
                "windows"
            ],
            "repo": "https://github.com/BarrassDev/openDeck",
            "cloneUrl": "https://github.com/BarrassDev/openDeck.git",
            "subdirectory": "modules/media-controls",
            "homepage": "https://github.com/BarrassDev/openDeck",
            "license": "MIT",
            "bundled": true
        },
        {
            "id": "wavelink",
            "name": "Elgato Wave Link",
            "description": "Control Elgato Wave Link 3 \u2014 mute and level for microphones, outputs, channels and mixes, with live button state.",
            "author": "OpenDeck Team",
            "version": "1.0.0",
            "tags": [
                "elgato",
                "wavelink",
                "audio",
                "mixer"
            ],
            "repo": "https://github.com/BarrassDev/openDeck",
            "cloneUrl": "https://github.com/BarrassDev/openDeck.git",
            "subdirectory": "modules/wavelink",
            "homepage": "https://github.com/BarrassDev/openDeck",
            "license": "MIT",
            "bundled": true
        }
